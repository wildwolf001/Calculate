# LLM 网关（Anthropic 兼容协议）
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-v4-flash[1m]
LLM_TIMEOUT_SECONDS=45

# 主循环
MAX_STEPS=24
MAX_ROW_LIMIT=2000
SQL_TIMEOUT_MS=8000

# 服务
HOST=127.0.0.1
PORT=8000

# 安全（可选）
# 设置后所有 /api、/docs 请求需带 X-API-Token 或 Authorization: Bearer <token>
API_TOKEN=
# 绑定非本机地址时必须显式确认（否则启动失败）
ALLOW_REMOTE=0
